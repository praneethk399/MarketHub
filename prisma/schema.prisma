generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum SocialVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum PurchaseVisibility {
  PRIVATE
  LIMITED
}

enum ListVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum ListRole {
  OWNER
  EDITOR
  VIEWER
}

enum ReadingStatus {
  NOT_STARTED
  CURRENTLY_READING
  FINISHED
}

enum SocialTargetType {
  BOOK
  PRODUCT
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  role                UserRole            @default(CUSTOMER)
  avatar              String?
  phone               String?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  cart                Cart?
  orders              Order[]
  vendor              Vendor?
  vendorApplications  VendorApplication[]
  addresses           Address[]
  wishlist            Wishlist?
  reviews             Review[]
  sessions            Session[]
  auditLogs           AuditLog[]
  friendshipsRequested Friendship[] @relation("FriendshipRequester")
  friendshipsReceived  Friendship[] @relation("FriendshipAddressee")
  socialPrivacy        SocialPrivacy?
  recommendationsSent  Recommendation[] @relation("RecommendationSender")
  recommendationsReceived Recommendation[] @relation("RecommendationRecipient")
  lists                SocialList[]
  listMemberships      ListMember[]
  readingProgress      ReadingProgress[]
}

model Vendor {
  id             String        @id @default(cuid())
  userId         String?       @unique
  name           String
  storeName      String?
  slug           String?       @unique
  description    String?
  logo           String?
  email          String?
  phone          String?
  city           String
  status         VendorStatus  @default(APPROVED)
  verified       Boolean       @default(false)
  booksSold      Int           @default(0)
  authenticity   Float         @default(0)
  onTimeDelivery Float         @default(0)
  returnRate     Float         @default(0)
  disputeRate    Float         @default(0)
  activeSince    DateTime      @default(now())
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  books          Book[]
  products       Product[]
  orderItems     OrderItem[]
  applications   VendorApplication[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
}

model Book {
  id            String      @id
  title         String
  author        String
  coverUrl      String
  isbn          String?
  price         Float?
  originalPrice Float?
  rating        Float?
  reviews       Int?
  stock         Int?
  status        String      @default("in-stock")
  badge         String?
  category      String
  format        String
  sellerCount   Int         @default(1)
  active        Boolean     @default(true)
  vendorId      String?
  vendor        Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviewEntries Review[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model VendorApplication {
  id           String       @id @default(uuid())
  userId       String
  vendorId     String?
  storeName    String
  description  String
  businessEmail String
  phone        String?
  status       VendorStatus @default(PENDING)
  adminNotes   String?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Product {
  id              String         @id @default(uuid())
  vendorId        String
  categoryId      String?
  title           String
  slug            String         @unique
  description     String
  author          String
  isbn            String?
  publisher       String?
  publicationYear Int?
  language        String         @default("en")
  format          String
  price           Decimal        @db.Decimal(10, 2)
  compareAtPrice  Decimal?       @db.Decimal(10, 2)
  status          ProductStatus  @default(DRAFT)
  rating          Float          @default(0)
  reviewCount     Int            @default(0)
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  inventory       Inventory?
  cartItems       ProductCartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  priceHistory    PriceHistory[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@index([vendorId, status])
  @@index([categoryId, status])
  @@index([isbn])
  @@index([author])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([quantity, reserved])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  productItems ProductCartItem[]
  updatedAt DateTime   @updatedAt
}

model ProductCartItem {
  id             String   @id @default(uuid())
  cartId         String
  productId      String
  quantity       Int      @default(1)
  priceAtAddition Decimal @db.Decimal(10, 2)
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([productId])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String?
  recipient   String
  line1       String
  line2       String?
  city        String
  region      String
  postalCode  String
  country     String   @default("IN")
  phone       String?
  isDefault   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId, isDefault])
}

model CartItem {
  id       String @id @default(cuid())
  cartId   String
  bookId   String
  quantity Int    @default(1)
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
}

model Order {
  id                      String      @id @default(cuid())
  userId                  String
  orderNumber             String?     @unique
  status                  OrderStatus @default(PLACED)
  subtotal                Decimal     @default(0) @db.Decimal(10, 2)
  shipping                Decimal     @default(0) @db.Decimal(10, 2)
  discount                Decimal     @default(0) @db.Decimal(10, 2)
  total                   Float
  shippingAddressSnapshot Json?
  user                    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                   OrderItem[]
  payment                 Payment?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  bookId               String?
  productId            String?
  vendorId             String?
  title                String
  productTitleSnapshot String?
  unitPrice            Float
  unitPriceSnapshot    Decimal? @db.Decimal(10, 2)
  subtotal             Decimal? @db.Decimal(10, 2)
  quantity             Int
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book                 Book?    @relation(fields: [bookId], references: [id], onDelete: Restrict)
  product              Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor               Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([vendorId, orderId])
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("INR")
  status                PaymentStatus @default(PENDING)
  method                String        @default("SIMULATED")
  transactionReference  String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt
}

model Review {
  id               String          @id @default(uuid())
  productId        String?
  bookId           String?
  userId           String
  rating           Int
  title            String?
  content          String
  verified         Boolean         @default(false)
  visibility       SocialVisibility @default(PUBLIC)
  containsSpoilers Boolean         @default(false)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  book             Book?           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  @@unique([productId, userId])
  @@unique([bookId, userId])
  @@index([productId, createdAt])
  @@index([bookId, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model SocialPrivacy {
  userId               String             @id
  reviews              SocialVisibility   @default(PUBLIC)
  purchases            PurchaseVisibility @default(PRIVATE)
  reading              SocialVisibility   @default(PRIVATE)
  defaultListVisibility ListVisibility    @default(PRIVATE)
  updatedAt            DateTime           @default(now()) @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id          String           @id @default(cuid())
  senderId    String
  recipientId String
  targetType  SocialTargetType
  targetId    String
  message     String?
  createdAt   DateTime         @default(now())
  sender      User             @relation("RecommendationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User             @relation("RecommendationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId, targetType, targetId])
  @@index([recipientId, createdAt])
  @@index([targetType, targetId])
}

model SocialList {
  id          String         @id @default(cuid())
  ownerId     String
  title       String
  description String?
  visibility  ListVisibility  @default(PRIVATE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       ListItem[]
  members     ListMember[]

  @@index([ownerId])
  @@index([visibility])
}

model ListItem {
  id           String           @id @default(uuid())
  listId       String
  targetType   SocialTargetType
  targetId     String
  addedById    String?
  note         String?
  preferred    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  list         SocialList       @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, targetType, targetId])
  @@index([targetType, targetId])
}

model ListMember {
  id        String     @id @default(uuid())
  listId    String
  userId    String
  role      ListRole   @default(VIEWER)
  createdAt DateTime   @default(now())
  list      SocialList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
}

model ReadingProgress {
  id                String          @id @default(uuid())
  userId            String
  targetType        SocialTargetType @default(BOOK)
  targetId          String
  status            ReadingStatus   @default(NOT_STARTED)
  progressPercentage Int            @default(0)
  notes             String?
  visibility        SocialVisibility @default(PRIVATE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId, visibility])
}

model PriceHistory {
  id         String   @id @default(uuid())
  productId  String
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
}

model SecuritySignal {
  id        String   @id @default(uuid())
  type      String
  severity  String   @default("LOW")
  subject   String
  subjectId String?
  count     Int      @default(1)
  details   Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([subject, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([action, createdAt])
}
